# Environment variable examples — copy to .env (do NOT commit secrets to git)

# Database
POSTGRES_USER=aiagent
POSTGRES_PASSWORD=change_me
POSTGRES_DB=aiagent
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Object store (S3-compatible)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=aiagent-bucket
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Vector store configuration (adapter-driven)
VECTOR_STORE_TYPE=weaviate    # options: weaviate | milvus | pgvector | weaviate (adapter selects)
VECTOR_STORE_HOST=vector-db
VECTOR_STORE_PORT=8080
# Weaviate-specific (optional)
WEAVIATE_AUTH_ANONYMOUS=true
WEAVIATE_DEFAULT_VECTORIZER=none

# LLM provider adapter
LLM_PROVIDER=local_model    # adapters: local_model | managed_provider_xyz
LLM_PROVIDER_URL=http://llm-proxy:8080

# Auth
JWT_SECRET=replace_with_strong_secret
OIDC_ISSUER=https://your-idp.example
SCIM_BASE_URL=https://scim.example

# Platform
KMS_URL=https://kms.example
AUDIT_WORM_ENABLED=true
LOG_LEVEL=info

# Action executor
ACTION_EXECUTOR_RETRY=3

# Other
NODE_ENV=development

# NOTE: Replace above with proper vault/secret manager in production
